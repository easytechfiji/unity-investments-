#!/bin/sh
# Runs before every commit. Enabled by `npm install` (the prepare script sets core.hooksPath).

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed, so staged files cannot be checked for secrets."
  echo "Install it (Windows: winget install gitleaks) and commit again."
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner || {
  echo "gitleaks found something that looks like a secret. Remove it before committing."
  exit 1
}

node scripts/check-text.mjs || exit 1
