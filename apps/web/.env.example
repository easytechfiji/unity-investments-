# Copy to .env.local for local development. Never commit .env.local.

# Public address of the storefront, used for canonical links and the sitemap.
SITE_URL=
# Where the storefront server fetches catalogue data, for example http://localhost:4000
API_URL=
# Where visitors' browsers send cart, checkout and form requests (the public API address).
NEXT_PUBLIC_API_URL=
# Origin of uploaded images when they are on Supabase Storage, for example https://abcd1234.supabase.co
MEDIA_ORIGIN=
# true only on the live production site. Anything else is kept out of Google.
ALLOW_INDEXING=
# true to send the Content Security Policy in report only mode while testing a change.
CSP_REPORT_ONLY=
