# Copy to .env for local development. Never commit .env.
# In staging and production these are set in the host's secret store.

NODE_ENV=
PORT=
LOG_LEVEL=
# Comma separated, for example http://localhost:3000,http://localhost:5173
CORS_ORIGINS=
# The admin app's address, for example http://localhost:5173
ADMIN_ORIGIN=
# Public storefront address, used in email links.
SITE_URL=
# Public address of this API, used for locally stored images.
API_PUBLIC_URL=
# Number of proxies in front of the API. 0 locally.
TRUST_PROXY=
# Send admin cookies over HTTPS only. true in staging and production.
COOKIE_SECURE=

# Postgres. Locally postgres://postgres:postgres@localhost:54322/od
# In production the Supabase pooler string (Supabase > Connect > Session pooler).
DATABASE_URL=

# Prices are in this currency. FJD.
SHOP_CURRENCY=
# Open decision. true or false, and the percent added when true.
TAX_ENABLED=
TAX_RATE=

# PayPal (developer.paypal.com > Apps and credentials). Leave empty to hide PayPal.
PAYPAL_ENV=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# The currency PayPal charges (it cannot charge FJD). For example AUD, NZD or USD.
PAYPAL_CURRENCY=

# Email: resend in production, file locally (writes to .data/outbox).
# EMAIL_FROM: Unity Investment <orders@unityfj.com>
# (verify the unityfj.com domain in Resend first; replies go to the shop email in admin Settings).
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=

# Cloudflare Turnstile. Empty locally skips the check.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Images: local in development, supabase in production.
STORAGE_DRIVER=
SUPABASE_STORAGE_BUCKET=
# Promotional videos. A separate bucket, public read, MP4 only.
SUPABASE_VIDEO_BUCKET=

# Supabase project URL, from Project Settings > Data API.
SUPABASE_URL=
# Publishable key (sb_publishable_...), from Project Settings > API Keys.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...), from Project Settings > API Keys. API server only.
SUPABASE_SECRET_KEY=
# Local development only: the fake auth server. Leave empty when using Supabase.
AUTH_URL=

# The old Unity Investment catalogue (VAULT), read only, for npm run import:vault.
# Its Supabase project URL and publishable key (sb_publishable_...).
VAULT_SUPABASE_URL=
VAULT_SUPABASE_PUBLISHABLE_KEY=
