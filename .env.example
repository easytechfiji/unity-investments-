# App
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:4000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=item-images

# Supabase values exposed to the browser. Use anon/public values only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_STORAGE_BUCKET=item-images

# Resend contact form
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL="Unity Investment <onboarding@resend.dev>"
CONTACT_EMAIL_TO=you@example.com
