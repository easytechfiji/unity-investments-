{
  "name": "unity-investment",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "node scripts/git-hooks.mjs",
    "dev": "node scripts/dev.mjs",
    "build:shared": "npm run build -w @od/shared",
    "build": "npm run build:shared && npm run build -w @od/api -w @od/web -w @od/admin",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present && tsc -p supabase/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "npm run build:shared && vitest run",
    "test:unit": "npm run build:shared && vitest run --project unit",
    "test:integration": "npm run build:shared && vitest run --project integration",
    "test:e2e": "npm run build:shared && npm run test:e2e -w @od/web",
    "check:text": "node scripts/check-text.mjs",
    "db:start": "node scripts/db/local.mjs start",
    "db:stop": "node scripts/db/local.mjs stop",
    "db:migrate": "node scripts/db/migrate.mjs --local",
    "db:reset": "node scripts/db/migrate.mjs --local --fresh && node scripts/db/samples.mjs load --local",
    "db:samples": "node scripts/db/samples.mjs load --local",
    "db:remove-samples": "node scripts/db/samples.mjs remove --local",
    "db:push": "node --env-file-if-exists=.env scripts/db/migrate.mjs",
    "admin:create": "npm run admin:create -w @od/api --",
    "import:vault": "npm run import:vault -w @od/api --",
    "storage:buckets": "npm run storage:buckets -w @od/api --",
    "screenshots": "node scripts/screenshots.mjs",
    "brand:assets": "node scripts/brand/make-assets.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/db/backup.mjs dump",
    "db:restore-test": "node scripts/db/backup.mjs restore-test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
